<Window x:Class="DotStream.App.ForegroundWindowInspector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's in front?"
        Icon="Resources/dotstream.ico"
        Height="330" Width="560"
        Background="{StaticResource Surface}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="13" FontWeight="SemiBold"
                   Text="The last window that had focus" />

        <TextBlock Grid.Row="1" Margin="0,3,0,12" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMuted}"
                   Text="Switch to an application and come back. This is what dotStream saw, and whether it recognised it. If a page will not follow an app, the answer is here." />

        <Border Grid.Row="2" Background="#FF0E0E11" CornerRadius="6" Padding="14,12">
            <TextBlock x:Name="Details" FontFamily="Consolas" FontSize="12"
                       TextWrapping="Wrap" LineHeight="20"
                       Foreground="{StaticResource TextPrimary}" />
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" x:Name="Hint" VerticalAlignment="Center"
                       FontSize="10.5" Foreground="{StaticResource TextMuted}"
                       TextTrimming="CharacterEllipsis" />
            <Button Content="Close" HorizontalAlignment="Right" MinWidth="88"
                    Click="OnClose" IsDefault="True" Margin="8,0,0,0" />
            <Button Content="Copy" HorizontalAlignment="Right" MinWidth="88"
                    Click="OnCopy" />
        </DockPanel>
    </Grid>
</Window>
