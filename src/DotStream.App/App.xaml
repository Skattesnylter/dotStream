<Application x:Class="DotStream.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <SolidColorBrush x:Key="Surface" Color="#FF121214" />
        <SolidColorBrush x:Key="SurfaceRaised" Color="#FF1B1B1F" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFE8E8EC" />
        <SolidColorBrush x:Key="TextMuted" Color="#FF80808A" />
        <SolidColorBrush x:Key="Accent" Color="#FF4DD9E8" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <ControlTemplate x:Key="TopLevelMenuHeader" TargetType="MenuItem">
            <Grid>
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        CornerRadius="4" Padding="10,4">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </Border>
                <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Background="#FF1B1B1F" BorderBrush="#FF33333A" BorderThickness="1"
                            CornerRadius="6" Padding="4" MinWidth="150">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#FF26262C" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SubMenuItem" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                               Margin="28,0,0,0" Opacity="0.45" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#FF2E2E36" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- A MenuItem that has children takes the SubmenuHeader role, which is a
             separate template from SubmenuItem. Leaving it out does not fail loudly:
             WPF quietly falls back to its default, and the submenu opens white on a
             dark app. -->
        <ControlTemplate x:Key="SubMenuHeader" TargetType="MenuItem">
            <Grid>
                <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        <Path Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center"
                              Data="M0,0 L4,4 L0,8 Z" Opacity="0.55"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                </Border>
                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-5"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Background="#FF1B1B1F" BorderBrush="#FF33333A" BorderThickness="1"
                            CornerRadius="6" Padding="4" MinWidth="170">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#FF2E2E36" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template" Value="{StaticResource SubMenuItem}" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopLevelMenuHeader}" />
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource SubMenuHeader}" />
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template" Value="{StaticResource SubMenuItem}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#FF1B1B1F" BorderBrush="#FF33333A" BorderThickness="1"
                                CornerRadius="6" Padding="4" MinWidth="170">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WPF's default ToolTip is light. On a black app that means readable text on
             a white slab that looks like a rendering fault. -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#FF1B1B1F" BorderBrush="#FF3A3A44" BorderThickness="1"
                                CornerRadius="5" Padding="10,7">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Background" Value="#FF33333A" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#FF33333A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF26262C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
