<Window x:Class="DotStream.App.DiscordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discord key"
        Height="500" Width="430"
        Background="{StaticResource Surface}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22,18,22,18">

        <TextBlock Text="Discord key" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Margin="0,3,0,16" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                   Text="These keys read Discord's own state, so they are lit when you are actually muted, including when you muted yourself by clicking in Discord." />

        <TextBlock Text="What should the key do?" Margin="0,0,0,4" />
        <ComboBox x:Name="ActionBox" Margin="0,0,0,14" SelectionChanged="OnChanged">
            <ComboBoxItem Content="Mute and unmute the microphone" Tag="ToggleMute" IsSelected="True" />
            <ComboBoxItem Content="Deafen and undeafen" Tag="ToggleDeafen" />
            <ComboBoxItem Content="Leave the voice channel" Tag="LeaveVoice" />
            <ComboBoxItem Content="Join a voice channel" Tag="JoinChannel" />
        </ComboBox>

        <StackPanel x:Name="ChannelPanel" Visibility="Collapsed">
            <TextBlock Text="Which server?" Margin="0,0,0,4" />
            <ComboBox x:Name="GuildBox" Margin="0,0,0,10" SelectionChanged="OnGuildChanged"
                      DisplayMemberPath="Name" />

            <TextBlock Text="Which voice channel?" Margin="0,0,0,4" />
            <ComboBox x:Name="ChannelBox" Margin="0,0,0,14" SelectionChanged="OnChanged"
                      DisplayMemberPath="Name" />
        </StackPanel>

        <TextBlock Text="Label on the key" Margin="0,0,0,4" />
        <TextBox x:Name="LabelBox" Background="#FF0E0E11" Foreground="{StaticResource TextPrimary}"
                 CaretBrush="{StaticResource Accent}" BorderBrush="#FF33333A"
                 Padding="6,5" Margin="0,0,0,14" TextChanged="OnChanged" />

        <Border Background="#FF0E0E11" CornerRadius="6" Padding="12">
            <TextBlock x:Name="Preview" FontFamily="Consolas" FontSize="12"
                       TextWrapping="Wrap" Foreground="#FF9CDCFE" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Padding="12,5" IsCancel="True" />
            <Button Content="Save" Padding="16,5" Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
        </StackPanel>

    </StackPanel>
</Window>
