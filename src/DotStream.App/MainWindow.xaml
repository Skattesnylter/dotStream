<Window x:Class="DotStream.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DotStream.App"
        Title="dotStream"
        Icon="Resources/dotstream.ico"
        Height="820" Width="1180"
        Background="{StaticResource Surface}"
        WindowStartupLocation="CenterScreen">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:DeckCommands.ShowConsole}" Executed="OnShowConsoleCommand" />
    </Window.CommandBindings>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Grid.ColumnSpan="2" Margin="-4,-4,0,6">
            <MenuItem Header="_File">
                <MenuItem Header="_Select applications..." Click="OnSelectApplications" />
                <MenuItem Header="_Reload applications" Click="OnReloadApps" InputGestureText="F5" />
                <Separator />
                <MenuItem Header="Open _fonts folder" Click="OnOpenFontsFolder" />
                <Separator />
                <MenuItem x:Name="McpMenuItem" Header="_Agent bridge (MCP)..." Click="OnToggleMcp" />
                <Separator />
                <MenuItem Header="Reset deck _layout..." Click="OnResetLayout" />
                <Separator />
                <MenuItem Header="_Hide to tray" Click="OnHideToTray" InputGestureText="Alt+F4" />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Icons..." Click="OnShowIcons" />
                <MenuItem Header="_What's in front?..." Click="OnShowForeground"
                          ToolTip="What dotStream saw when you last switched away - and whether it recognised it." />
                <MenuItem Header="_Console" Command="{x:Static local:DeckCommands.ShowConsole}"
                          InputGestureText="Ctrl+L" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Instructions for your AI assistant..." Click="OnShowAgentHelp"
                          ToolTip="Opens the page dotStream serves to agents. Paste the address to your assistant, or read it yourself." />
                <Separator />
                <MenuItem Header="_About dotStream" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="dot" FontSize="24" FontWeight="Light" VerticalAlignment="Center" />
            <TextBlock Text="Stream" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
            <TextBlock x:Name="TransportLabel" Text="  -  simulator"
                       FontSize="13" Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center" Margin="8,4,0,0" />
        </StackPanel>

        <!-- The palette is contextual: applications belong on the home page, actions
             belong on an app's own page. Showing both at once was mostly noise, and
             it squeezed each list into its own scrollbar. -->
        <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource SurfaceRaised}"
                CornerRadius="10" Padding="12" Margin="0,0,16,0">
            <Grid>

                <DockPanel x:Name="AppsPanel">
                    <TextBlock DockPanel.Dock="Top" Text="Installed applications"
                               FontSize="13" FontWeight="SemiBold" Margin="2,0,0,2" />
                    <TextBlock DockPanel.Dock="Top" x:Name="AppCountLabel" Text="loading..."
                               FontSize="11" Foreground="{StaticResource TextMuted}" Margin="2,0,0,8" />

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBox x:Name="SearchBox"
                                 Background="#FF0E0E11" Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource Accent}" BorderBrush="#FF33333A"
                                 Padding="6,5,26,5" FontSize="12"
                                 TextChanged="OnSearchChanged" />
                        <Button x:Name="ClearSearchButton" Content="&#x2715;"
                                Width="20" Height="20" FontSize="10" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource Accent}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,4,0" Visibility="Collapsed"
                                Click="OnClearSearch" ToolTip="Clear the search" />
                    </Grid>

                    <Button DockPanel.Dock="Top" Content="Choose which apps to show..."
                            FontSize="11" Padding="8,4" Margin="0,0,0,8"
                            HorizontalAlignment="Stretch" Click="OnSelectApplications" />

                    <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnAppSelected"
                             PreviewMouseMove="OnAppListMouseMove">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <DockPanel x:Name="ActionsPanel" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Text="Actions"
                               FontSize="13" FontWeight="SemiBold" Margin="2,0,0,2" />
                    <TextBlock DockPanel.Dock="Top" x:Name="ActionsSubtitle"
                               FontSize="11" Foreground="{StaticResource TextMuted}"
                               Margin="2,0,0,10" TextWrapping="Wrap" />

                    <ListBox x:Name="ActionList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnActionSelected"
                             IsSynchronizedWithCurrentItem="False"
                             PreviewMouseMove="OnActionListMouseMove"
                             PreviewMouseLeftButtonUp="OnActionListClick"
                             PreviewMouseRightButtonUp="OnActionListRightClick">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="10"
                                                   FontWeight="SemiBold" Margin="2,10,0,4"
                                                   Foreground="{StaticResource TextMuted}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="5" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="5" ClipToBounds="True"
                                            Margin="0,0,12,0">
                                        <Image Source="{Binding Thumbnail}" Stretch="Fill" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                        <TextBlock Text="{Binding Description}" FontSize="10"
                                                   Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Background="#FF0A0A0C" CornerRadius="10">
            <DockPanel Margin="14,12,14,14">
                <DockPanel DockPanel.Dock="Top" Margin="4,0,4,10">
                    <Button x:Name="BackButton" DockPanel.Dock="Left" Content="&#x2190;  Back"
                            Padding="10,4" FontSize="11" Click="OnBack"
                            Visibility="Collapsed" Margin="0,0,12,0" />
                    <Button x:Name="FollowButton" DockPanel.Dock="Right" Content="Follow focus: on"
                            Padding="10,4" FontSize="11" Click="OnToggleFollow"
                            HorizontalAlignment="Right"
                            ToolTip="Open an app's page automatically when you switch to it. Navigating by hand holds the deck until you go Back." />
                    <TextBlock x:Name="BreadcrumbLabel" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource TextMuted}" Text="Home" />
                </DockPanel>
                <ContentControl x:Name="DeckHost" />
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="12,8"
                Background="{StaticResource SurfaceRaised}" CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Label rendering" VerticalAlignment="Center" FontSize="11"
                           FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,14,0" />

                <Button x:Name="FontButton" Content="Verdana" FontSize="11" Padding="10,4" MinWidth="110"
                        Click="OnPickFont" Margin="0,0,8,0"
                        ToolTip="Choose a font. Your own go in %APPDATA%\dotStream\fonts." />
                <Button x:Name="WeightButton" Content="SemiBold" FontSize="11" Padding="10,4" MinWidth="84"
                        Click="OnCycleWeight" Margin="0,0,8,0"
                        ToolTip="Stroke weight - the most useful knob as the size drops" />
                <Button x:Name="FormatButton" Content="Ideal" FontSize="11" Padding="10,4" MinWidth="72"
                        Click="OnCycleFormat" Margin="0,0,8,0"
                        ToolTip="Ideal keeps letter spacing; Display snaps stems to the pixel grid" />
                <Button x:Name="RenderButton" Content="Grayscale" FontSize="11" Padding="10,4" MinWidth="84"
                        Click="OnCycleRender" Margin="0,0,16,0"
                        ToolTip="Antialiasing: grayscale, ClearType subpixel, or none" />

                <TextBlock x:Name="LabelSizeLabel" Text="12.5 px" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,8,0" MinWidth="46" />
                <Slider x:Name="LabelSizeSlider" Width="150" Minimum="8" Maximum="18" Value="12.5"
                        TickFrequency="0.5" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ValueChanged="OnLabelSizeChanged"
                        ToolTip="Label size in pixels" />

                <Button Content="Reset" FontSize="11" Padding="10,4" Margin="16,0,0,0" Click="OnResetTextLab" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Brightness" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}" FontSize="12" Margin="14,0,8,0" />
                    <Slider x:Name="BrightnessSlider" Width="120" Minimum="0" Maximum="100" Value="80"
                            VerticalAlignment="Center" ValueChanged="OnBrightnessChanged" />
                    <Button Content="Reload apps" Margin="16,0,0,0" Click="OnReloadApps" />
                </StackPanel>

                <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" FontSize="12"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMuted}"
                           Text="Drag an app onto a key. Press an app key to launch it; press it again once running to open its own page." />
            </DockPanel>
        </Border>
    </Grid>
</Window>
