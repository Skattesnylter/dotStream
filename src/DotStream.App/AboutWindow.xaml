<Window x:Class="DotStream.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About dotStream"
        Icon="Resources/dotstream.ico"
        Height="540" Width="440"
        Background="{StaticResource Surface}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="AboutLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="TextDecorations" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="dot" FontSize="30" FontWeight="Light" />
            <TextBlock Text="Stream" FontSize="30" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent}" />
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="VersionLabel" Margin="0,2,0,0"
                   FontSize="12" Foreground="{StaticResource TextMuted}" />

        <TextBlock Grid.Row="2" Margin="0,16,0,0" FontSize="12.5" TextWrapping="Wrap"
                   Text="Controller software for the AJAZZ AKP153E stream controller." />

        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <TextBlock Text="DEVELOPER" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMuted}" />
            <TextBlock Text="Thomas Blix" FontSize="14" Margin="0,4,0,0" />
            <TextBlock Margin="0,2,0,0" FontSize="12.5">
                <Hyperlink NavigateUri="https://github.com/Skattesnylter/dotStream"
                           Style="{StaticResource AboutLink}"
                           RequestNavigate="OnNavigate">github.com/Skattesnylter/dotStream</Hyperlink>
            </TextBlock>
        </StackPanel>

        <TextBlock Grid.Row="4" Margin="0,20,0,0" FontSize="12">
            <Hyperlink Style="{StaticResource AboutLink}" Click="OnShowLicence">Apache License 2.0</Hyperlink>
            <Run Text="   ·   " Foreground="{StaticResource TextMuted}" />
            <Hyperlink Style="{StaticResource AboutLink}" Click="OnShowCredits">Credits</Hyperlink>
            <Run Text="   ·   " Foreground="{StaticResource TextMuted}" />
            <Hyperlink Style="{StaticResource AboutLink}" Click="OnOpenSettingsFolder">Settings folder</Hyperlink>
        </TextBlock>

        <TextBlock Grid.Row="5" Margin="0,20,0,0" FontSize="10.5" TextWrapping="Wrap"
                   LineHeight="16" Foreground="{StaticResource TextMuted}"
                   Text="Provided as is, without warranty of any kind. You use it at your own risk, and the author accepts no liability for any damage or loss arising from its use. The licence sets out the full terms.&#x0a;&#x0a;Unofficial and reverse-engineered. Not affiliated with, authorised by, or endorsed by AJAZZ, Mirabox or Elgato; their names describe hardware compatibility only.&#x0a;&#x0a;No telemetry. Installed applications and media sessions are read locally and never leave this machine." />

        <DockPanel Grid.Row="6" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" x:Name="RuntimeLabel" VerticalAlignment="Center"
                       FontSize="10.5" Foreground="{StaticResource TextMuted}" />
            <Button Content="Close" HorizontalAlignment="Right" MinWidth="88"
                    Click="OnClose" IsDefault="True" />
        </DockPanel>
    </Grid>
</Window>
