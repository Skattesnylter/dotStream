<Window x:Class="DotStream.App.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dotStream"
        Icon="Resources/dotstream.ico"
        SizeToContent="Height" Width="400"
        Background="{StaticResource Surface}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22,20,22,18">

        <TextBlock x:Name="PromptLabel" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="HintLabel" FontSize="11" Foreground="{StaticResource TextMuted}"
                   Margin="0,4,0,12" TextWrapping="Wrap" />

        <TextBox x:Name="Input"
                 Background="#FF0E0E11" Foreground="{StaticResource TextPrimary}"
                 CaretBrush="{StaticResource Accent}" BorderBrush="#FF33333A"
                 Padding="8,6" FontSize="13"
                 KeyDown="OnKeyDown" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ResetButton" Content="Use default" MinWidth="96"
                    Click="OnReset" Visibility="Collapsed" Margin="0,0,10,0" />
            <Button Content="Cancel" MinWidth="88" Click="OnCancel" />
            <Button Content="Save" MinWidth="88" Margin="10,0,0,0" Click="OnSave"
                    Background="#FF12343A" BorderBrush="{StaticResource Accent}" />
        </StackPanel>

    </StackPanel>
</Window>
