<Window x:Class="DotStream.App.TextMacroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text macro"
        Icon="Resources/dotstream.ico"
        SizeToContent="Height" Width="470"
        Background="{StaticResource Surface}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22,20,22,18">

        <TextBlock Text="Type a block of text" FontSize="14" FontWeight="SemiBold" />
        <TextBlock Margin="0,3,0,14" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMuted}"
                   Text="Typed into whichever window has focus, character by character, so it works anywhere and is not affected by your keyboard layout. Line breaks are typed as Enter." />

        <TextBox x:Name="TextBox" Height="104"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="#FF0E0E11" Foreground="{StaticResource TextPrimary}"
                 CaretBrush="{StaticResource Accent}" BorderBrush="#FF33333A"
                 Padding="8,6" FontFamily="Consolas" FontSize="12.5"
                 TextChanged="OnTextChanged" />

        <DockPanel Margin="0,8,0,0">
            <Button x:Name="EnterButton" DockPanel.Dock="Left" Content="Press Enter afterwards: no"
                    FontSize="10.5" Padding="8,3" Click="OnToggleEnter"
                    ToolTip="A macro that submits the form it just filled in is a different thing from one that types." />
            <TextBlock x:Name="LengthLabel" VerticalAlignment="Center" Margin="10,0,0,0"
                       FontSize="11" Foreground="{StaticResource TextMuted}" />
        </DockPanel>

        <TextBlock Text="KEY LABEL" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,4"
                   Foreground="{StaticResource TextMuted}" />
        <TextBox x:Name="LabelBox"
                 Background="#FF0E0E11" Foreground="{StaticResource TextPrimary}"
                 CaretBrush="{StaticResource Accent}" BorderBrush="#FF33333A"
                 Padding="7,5" FontSize="12" TextChanged="OnLabelChanged" />

        <DockPanel Margin="0,16,0,4">
            <TextBlock DockPanel.Dock="Left" Text="ICON" FontSize="10" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
            <TextBlock x:Name="IconHint" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="10" Foreground="{StaticResource TextMuted}"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Border Background="{StaticResource SurfaceRaised}" CornerRadius="8" Padding="6" Height="132">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="IconPanel" />
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" MinWidth="88" Click="OnCancel" />
            <Button x:Name="SaveButton" Content="Save" MinWidth="88" Margin="10,0,0,0"
                    Click="OnSave" IsEnabled="False"
                    Background="#FF12343A" BorderBrush="{StaticResource Accent}" />
        </StackPanel>

    </StackPanel>
</Window>
