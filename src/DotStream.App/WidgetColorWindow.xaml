<Window x:Class="DotStream.App.WidgetColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget colours"
        Icon="Resources/dotstream.ico"
        Height="430" Width="560"
        Background="{StaticResource Surface}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="22,18,22,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="HeadingLabel"
                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14" />

        <!-- Live preview at three times the real cell size, nearest-neighbour, so what
             you see is the pixels the device will get. -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,22,0">
            <Border Width="255" Height="255" CornerRadius="8" ClipToBounds="True"
                    BorderBrush="#FF33333A" BorderThickness="1">
                <Image x:Name="Preview" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <TextBlock Text="Actual pixels, shown at 3x" FontSize="10.5" Margin="2,8,0,0"
                       Foreground="{StaticResource TextMuted}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock Text="WHICH COLOUR" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" />

            <UniformGrid x:Name="RolePanel" Columns="2" Margin="0,0,0,16" />

            <TextBlock x:Name="ChannelR" Text="Red" FontSize="11" Foreground="{StaticResource TextMuted}" />
            <Slider x:Name="SliderR" Minimum="0" Maximum="255" TickFrequency="1"
                    IsSnapToTickEnabled="True" ValueChanged="OnChannelChanged" Margin="0,0,0,8" />

            <TextBlock x:Name="ChannelG" Text="Green" FontSize="11" Foreground="{StaticResource TextMuted}" />
            <Slider x:Name="SliderG" Minimum="0" Maximum="255" TickFrequency="1"
                    IsSnapToTickEnabled="True" ValueChanged="OnChannelChanged" Margin="0,0,0,8" />

            <TextBlock x:Name="ChannelB" Text="Blue" FontSize="11" Foreground="{StaticResource TextMuted}" />
            <Slider x:Name="SliderB" Minimum="0" Maximum="255" TickFrequency="1"
                    IsSnapToTickEnabled="True" ValueChanged="OnChannelChanged" Margin="0,0,0,14" />

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Hex" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" />
                <TextBox x:Name="HexBox" Width="96" Padding="6,4" FontSize="12"
                         FontFamily="Cascadia Mono, Consolas"
                         Background="#FF0E0E11" Foreground="{StaticResource TextPrimary}"
                         CaretBrush="{StaticResource Accent}" BorderBrush="#FF33333A"
                         KeyDown="OnHexKeyDown" LostFocus="OnHexCommitted" />
                <Border x:Name="Swatch" Width="34" Height="26" CornerRadius="4" Margin="10,0,0,0"
                        BorderBrush="#FF33333A" BorderThickness="1" />
            </StackPanel>
        </StackPanel>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Content="Reset to default" MinWidth="120" Click="OnReset" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="88" Click="OnCancel" />
                <Button Content="Save" MinWidth="88" Margin="10,0,0,0" Click="OnSave"
                        Background="#FF12343A" BorderBrush="{StaticResource Accent}" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
