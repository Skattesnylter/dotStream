<Window x:Class="DotStream.App.TextViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dotStream"
        Icon="Resources/dotstream.ico"
        Height="620" Width="760"
        Background="{StaticResource Surface}"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="18">

        <TextBlock DockPanel.Dock="Top" x:Name="HeadingLabel"
                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Copy" MinWidth="88" Click="OnCopy" />
            <Button Content="Close" MinWidth="88" Margin="10,0,0,0" Click="OnClose" IsDefault="True" />
        </StackPanel>

        <Border Background="{StaticResource SurfaceRaised}" CornerRadius="8" Padding="4">
            <TextBox x:Name="Body"
                     IsReadOnly="True"
                     Background="Transparent"
                     Foreground="{StaticResource TextPrimary}"
                     BorderThickness="0"
                     FontFamily="Cascadia Mono, Consolas, Courier New"
                     FontSize="11.5"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Padding="10" />
        </Border>

    </DockPanel>
</Window>
