<Window x:Class="DotStream.App.McpBindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Call an MCP tool"
        Icon="Resources/dotstream.ico"
        Height="560" Width="620"
        Background="{StaticResource Surface}"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="22,18,22,16">

        <TextBlock DockPanel.Dock="Top" Text="Call an MCP tool"
                   FontSize="15" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Margin="0,3,0,14" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMuted}"
                   Text="Point this at any MCP server. The tool list is read from the server itself, so nothing here is specific to a particular one." />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock x:Name="ResultLabel" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"
                       MaxHeight="70" />
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Test now" MinWidth="96" Click="OnTest" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" MinWidth="88" Click="OnCancel" />
                    <Button x:Name="SaveButton" Content="Save" MinWidth="88" Margin="10,0,0,0"
                            Click="OnSave" IsEnabled="False"
                            Background="#FF12343A" BorderBrush="{StaticResource Accent}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Connect" MinWidth="90" Margin="10,0,0,0"
                        Click="OnConnect" />
                <StackPanel>
                    <TextBlock Text="SERVER URL" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                    <TextBox x:Name="UrlBox" Text="http://127.0.0.1:8787/"
                             Background="#FF0E0E11" Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource Accent}" BorderBrush="#FF33333A"
                             Padding="7,5" FontSize="12" />
                </StackPanel>
            </DockPanel>

            <TextBlock Grid.Row="1" Text="TOOL" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />

            <Border Grid.Row="2" Background="{StaticResource SurfaceRaised}" CornerRadius="8" Padding="6">
                <ListBox x:Name="ToolList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnToolSelected">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="{Binding Description}" FontSize="11"
                                           Foreground="{StaticResource TextMuted}"
                                           TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="ARGUMENTS (JSON)" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                <TextBox x:Name="ArgumentsBox" Height="66" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         Background="#FF0E0E11" Foreground="{StaticResource TextPrimary}"
                         CaretBrush="{StaticResource Accent}" BorderBrush="#FF33333A" Padding="7,5" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                <TextBlock Text="KEY LABEL" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                <TextBox x:Name="LabelBox"
                         Background="#FF0E0E11" Foreground="{StaticResource TextPrimary}"
                         CaretBrush="{StaticResource Accent}" BorderBrush="#FF33333A"
                         Padding="7,5" FontSize="12" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
