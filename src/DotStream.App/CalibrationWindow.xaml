<Window x:Class="DotStream.App.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibrate cells"
        Height="470" Width="440"
        Background="#FF141416"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE8E8EC" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,14" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,18">

        <TextBlock Text="Calibrate cells" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="DeviceLabel" Margin="0,3,0,16" Foreground="#FF80808A"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="SizeLabel" Text="Cell size" />
        <Slider x:Name="SizeSlider" Minimum="60" Maximum="160" ValueChanged="OnChanged" />

        <TextBlock x:Name="RotationLabel" Text="Rotation" />
        <Slider x:Name="RotationSlider" Minimum="0" Maximum="270" TickFrequency="90"
                ValueChanged="OnChanged" />

        <CheckBox x:Name="PatternCheck" IsChecked="True" Foreground="#FFE8E8EC"
                  Content="Show the measuring pattern" Margin="0,0,0,12"
                  Checked="OnChanged" Unchecked="OnChanged" />

        <Border Background="#FF0E0E11" CornerRadius="6" Padding="12">
            <TextBlock x:Name="Readout" FontFamily="Consolas" FontSize="12"
                       TextWrapping="Wrap" Foreground="#FF9CDCFE" />
        </Border>

        <TextBlock Margin="0,14,0,0" Foreground="#FF80808A" TextWrapping="Wrap"
                   Text="The pattern puts a coloured band on each edge of every cell — red at the top, yellow left, green right, blue at the bottom. The size is right when all four bands look equally thick and none of them is missing. Turn the pattern off to check the result against your own icons." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Reset to 100" Padding="12,5" Click="OnReset" />
            <Button Content="Cancel" Padding="12,5" Margin="8,0,0,0" IsCancel="True" />
            <Button Content="Save" Padding="16,5" Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
        </StackPanel>

    </StackPanel>
</Window>
