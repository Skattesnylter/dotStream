<Window x:Class="DotStream.App.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dotStream console"
        Icon="Resources/dotstream.ico"
        Height="520" Width="900"
        Background="{StaticResource Surface}"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="14">

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="FilterAll" Content="All" MinWidth="70" FontSize="11" Padding="10,4"
                        Click="OnFilterAll" Margin="0,0,6,0" />
                <Button x:Name="FilterIn" Content="&#x25B8;  Incoming" MinWidth="96" FontSize="11" Padding="10,4"
                        Click="OnFilterIn" Margin="0,0,6,0" />
                <Button x:Name="FilterOut" Content="&#x25C2;  Outgoing" MinWidth="96" FontSize="11" Padding="10,4"
                        Click="OnFilterOut" Margin="0,0,6,0" />
                <Button x:Name="FilterNote" Content="&#xB7;  Notes" MinWidth="80" FontSize="11" Padding="10,4"
                        Click="OnFilterNote" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="AutoScroll" Content="Follow" IsChecked="True" FontSize="11"
                          VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                          Margin="0,0,14,0" />
                <Button Content="Copy" MinWidth="76" FontSize="11" Padding="10,4" Click="OnCopy" Margin="0,0,6,0" />
                <Button Content="Clear" MinWidth="76" FontSize="11" Padding="10,4" Click="OnClear" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="CountLabel" Margin="2,8,0,0"
                   FontSize="11" Foreground="{StaticResource TextMuted}" />

        <Border Background="#FF0A0A0C" CornerRadius="8" Padding="4">
            <ListBox x:Name="EntryList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Time}" FontFamily="Cascadia Mono, Consolas"
                                       FontSize="11" Foreground="#FF5A5A66" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Arrow}" FontSize="11"
                                       Foreground="{Binding Colour}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="11"
                                       FontFamily="Cascadia Mono, Consolas"
                                       Foreground="{Binding Colour}" MinWidth="76" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="3" Text="{Binding Text}" FontSize="11.5"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
