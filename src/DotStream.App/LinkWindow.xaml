<Window x:Class="DotStream.App.LinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open a link"
        Icon="Resources/dotstream.ico"
        SizeToContent="Height" Width="440"
        Background="{StaticResource Surface}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22,20,22,18">

        <TextBlock Text="Open a link" FontSize="14" FontWeight="SemiBold" />
        <TextBlock Margin="0,3,0,14" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMuted}"
                   Text="A web address, a file, or a folder. Opens in whatever Windows uses for it. A missing https:// is added for you." />

        <TextBlock Text="ADDRESS" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"
                   Foreground="{StaticResource TextMuted}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Folder..." FontSize="10.5" Padding="8,3"
                    Margin="8,0,0,0" Click="OnBrowse" />
            <TextBox x:Name="TargetBox"
                     Background="#FF0E0E11" Foreground="{StaticResource TextPrimary}"
                     CaretBrush="{StaticResource Accent}" BorderBrush="#FF33333A"
                     Padding="7,5" FontSize="12" FontFamily="Consolas"
                     TextChanged="OnChanged" />
        </DockPanel>

        <TextBlock Text="KEY LABEL" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,4"
                   Foreground="{StaticResource TextMuted}" />
        <TextBox x:Name="LabelBox"
                 Background="#FF0E0E11" Foreground="{StaticResource TextPrimary}"
                 CaretBrush="{StaticResource Accent}" BorderBrush="#FF33333A"
                 Padding="7,5" FontSize="12" TextChanged="OnChanged" />

        <DockPanel Margin="0,16,0,4">
            <TextBlock DockPanel.Dock="Left" Text="ICON" FontSize="10" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
            <TextBlock x:Name="IconHint" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="10" Foreground="{StaticResource TextMuted}"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Border Background="{StaticResource SurfaceRaised}" CornerRadius="8" Padding="6" Height="132">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="IconPanel" />
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Test it" MinWidth="88" Click="OnTest" Margin="0,0,10,0" />
            <Button Content="Cancel" MinWidth="88" Click="OnCancel" />
            <Button x:Name="SaveButton" Content="Save" MinWidth="88" Margin="10,0,0,0"
                    Click="OnSave" IsEnabled="False"
                    Background="#FF12343A" BorderBrush="{StaticResource Accent}" />
        </StackPanel>

    </StackPanel>
</Window>
